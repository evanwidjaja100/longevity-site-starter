{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "740px",
      "wideSize": "1180px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "ink", "name": "Ink", "color": "#17232D" },
        { "slug": "muted", "name": "Muted", "color": "#5E6E79" },
        { "slug": "subtle", "name": "Subtle", "color": "#6F7E87" },
        { "slug": "navy", "name": "Navy", "color": "#153042" },
        { "slug": "paper", "name": "Paper", "color": "#ffffff" },
        { "slug": "surface", "name": "Canvas", "color": "#F4F8FA" },
        { "slug": "surface-subtle", "name": "Surface Subtle", "color": "#EAF1F4" },
        { "slug": "border", "name": "Border", "color": "#D6E1E7" },
        { "slug": "border-strong", "name": "Border Strong", "color": "#AABBC5" },
        { "slug": "brand", "name": "Brand", "color": "#075E91" },
        { "slug": "brand-strong", "name": "Brand Strong", "color": "#064F79" },
        { "slug": "brand-hover", "name": "Brand Hover", "color": "#043B5C" },
        { "slug": "brand-subtle", "name": "Brand Soft", "color": "#E8F5FB" },
        { "slug": "focus", "name": "Focus", "color": "#005fcc" },
        { "slug": "success", "name": "Success", "color": "#197653" },
        { "slug": "success-subtle", "name": "Success Soft", "color": "#E8F6EF" },
        { "slug": "warning", "name": "Warning", "color": "#965A00" },
        { "slug": "warning-subtle", "name": "Warning Soft", "color": "#FFF4DE" },
        { "slug": "danger", "name": "Danger", "color": "#B42318" },
        { "slug": "danger-subtle", "name": "Danger Soft", "color": "#FDECEA" },
        { "slug": "info", "name": "Info", "color": "#174f78" },
        { "slug": "info-subtle", "name": "Info Subtle", "color": "#e5f1f8" },
        { "slug": "soft", "name": "Legacy Soft", "color": "#EAF1F4" },
        { "slug": "accent", "name": "Legacy Accent", "color": "#0B7FC2" },
        { "slug": "accent-soft", "name": "Legacy Accent Soft", "color": "#E8F5FB" },
        { "slug": "warning-soft", "name": "Legacy Warning Soft", "color": "#fff4d6" },
        { "slug": "warning-text", "name": "Legacy Warning Text", "color": "#633f00" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        { "slug": "system", "name": "System Sans", "fontFamily": "-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif" },
        { "slug": "serif", "name": "Editorial Serif", "fontFamily": "Georgia,\"Times New Roman\",serif" },
        { "slug": "mono", "name": "System Mono", "fontFamily": "ui-monospace,SFMono-Regular,Consolas,\"Liberation Mono\",monospace" }
      ],
      "fontSizes": [
        { "slug": "label", "name": "Label", "size": "0.75rem" },
        { "slug": "small", "name": "Metadata", "size": "0.875rem" },
        { "slug": "body", "name": "Body", "size": "1rem" },
        { "slug": "medium", "name": "Lead", "size": "1.125rem" },
        { "slug": "large", "name": "Section Heading", "size": "clamp(1.375rem, 2vw, 1.75rem)" },
        { "slug": "x-large", "name": "Article Title", "size": "clamp(2.25rem, 6vw, 4.75rem)" },
        { "slug": "display", "name": "Display", "size": "clamp(2.5rem, 7vw, 5rem)" }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "vw", "%"],
      "spacingSizes": [
        { "slug": "10", "name": "3XS", "size": "0.25rem" },
        { "slug": "20", "name": "2XS", "size": "0.5rem" },
        { "slug": "30", "name": "XS", "size": "0.75rem" },
        { "slug": "40", "name": "S", "size": "1.25rem" },
        { "slug": "50", "name": "M", "size": "2rem" },
        { "slug": "60", "name": "L", "size": "3rem" },
        { "slug": "70", "name": "XL", "size": "4.5rem" },
        { "slug": "80", "name": "2XL", "size": "6.5rem" }
      ]
    },
    "custom": {
      "radius": { "small": "4px", "card": "8px", "large": "12px", "pill": "999px" },
      "shadow": { "subtle": "0 0.3rem 1.2rem rgba(21, 48, 66, 0.07)" },
      "measure": { "article": "72ch", "compact": "60ch" }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--paper)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--system)",
      "fontSize": "var(--wp--preset--font-size--body)",
      "lineHeight": "1.72"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--system)",
          "fontWeight": "700",
          "lineHeight": "1.12"
        }
      },
      "link": {
        "color": { "text": "var(--wp--preset--color--brand)" }
      },
      "button": {
        "border": { "radius": "0.45rem" },
        "color": {
          "background": "var(--wp--preset--color--brand)",
          "text": "var(--wp--preset--color--paper)"
        },
        "typography": { "fontWeight": "700" }
      }
    },
    "blocks": {
      "core/button": { "border": { "radius": "0.45rem" } },
      "core/post-title": { "typography": { "fontFamily": "var(--wp--preset--font-family--system)" } },
      "core/post-excerpt": { "typography": { "lineHeight": "1.6" } },
      "core/pullquote": { "border": { "color": "var(--wp--preset--color--brand)" } },
      "core/code": { "typography": { "fontFamily": "var(--wp--preset--font-family--mono)", "fontSize": "0.9rem" } }
    },
    "spacing": { "blockGap": "1.35rem" }
  }
}
