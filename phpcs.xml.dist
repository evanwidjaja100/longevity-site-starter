<?xml version="1.0"?>
<ruleset name="Longevity Evidence Lab">
  <description>WordPress coding standards for first-party PHP.</description>
  <file>wp-content/mu-plugins</file>
  <file>wp-content/themes/longevity-starter</file>
  <file>scripts</file>
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <arg name="extensions" value="php" />
  <arg value="sp" />
  <rule ref="WordPress">
    <exclude-pattern>scripts/verify-release-evidence.php</exclude-pattern>
    <exclude-pattern>scripts/write-release-evidence-metadata.php</exclude-pattern>
    <exclude-pattern>scripts/generate-dependency-sbom.php</exclude-pattern>
  </rule>
  <rule ref="PSR12">
    <include-pattern>scripts/verify-release-evidence.php</include-pattern>
    <include-pattern>scripts/write-release-evidence-metadata.php</include-pattern>
    <include-pattern>scripts/generate-dependency-sbom.php</include-pattern>
  </rule>
  <rule ref="WordPress.WP.Capabilities">
    <properties><property name="custom_capabilities" value="approve_publication" /></properties>
  </rule>
  <rule ref="PHPCompatibilityWP">
    <properties><property name="testVersion" value="8.3-" /></properties>
  </rule>
</ruleset>
