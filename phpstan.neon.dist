includes:
  - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
  level: 5
  paths:
    - wp-content/mu-plugins/longevity-core
    - wp-content/themes/longevity-starter/functions.php
    - scripts
  excludePaths:
    - vendor
  scanFiles:
    - wp-content/mu-plugins/longevity-core.php
  bootstrapFiles:
    - tests/php/bootstrap.php
