<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/php/bootstrap.php" colors="true" cacheDirectory=".phpunit.cache" failOnWarning="true" failOnRisky="true" failOnSkipped="true" failOnIncomplete="true" beStrictAboutTestsThatDoNotTestAnything="true">
  <testsuites>
	<testsuite name="Longevity Core">
		<directory suffix="Test.php">tests/php</directory>
		<exclude>tests/php/RoutesTest.php</exclude>
	</testsuite>
  </testsuites>
  <!--
	Coverage semantics (PRV3-QA-03):
	- Local `composer test` runs assertions only; no coverage driver is required
	  and a missing driver can never turn a passing run into a failure.
	- CI requests coverage explicitly (see .github/workflows/ci.yml quality-php:
	  `composer test - - -coverage-clover=coverage.xml`) under PCOV and enforces
	  the minimum threshold; a missing driver there fails with a targeted error.
  -->
  <source>
	<include>
		<directory suffix=".php">wp-content/mu-plugins/longevity-core</directory>
	</include>
  </source>
</phpunit>
