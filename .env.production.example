# Managed-host production settings reference (not a Compose deployment file).
#
# Copy to .env.production, replace every secret with a unique high-entropy
# value, then validate with: scripts/validate-env.sh .env.production
# Never commit the resulting .env.production file.
WORDPRESS_DB_NAME=longevity
WORDPRESS_DB_USER=longevity_app
WORDPRESS_DB_PASSWORD=replace-with-unique-24+-char-secret
WORDPRESS_DB_ROOT_PASSWORD=replace-with-different-unique-secret

WP_SITE_URL=https://your-production-domain.example
WP_SITE_TITLE="Longevity Evidence Lab"
WP_ADMIN_USER=longevity_manager
WP_ADMIN_PASSWORD=replace-with-unique-24+-char-secret
WP_ADMIN_EMAIL=editor@your-production-domain.example
WP_ENVIRONMENT_TYPE=production
WP_TIMEZONE=UTC
WP_LOCALE=en_US
WP_DEBUG=false
WP_DEBUG_LOG=false
WP_DEBUG_DISPLAY=false
FORCE_SSL_ADMIN=true
DISALLOW_FILE_MODS=true
INSTALL_OPTIONAL_PLUGINS=0
