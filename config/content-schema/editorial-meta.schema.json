{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Longevity editorial metadata",
  "type": "object",
  "required": [
    "content_summary",
    "content_limitations",
    "commercial_relationship",
    "next_content_review_date",
    "editorial_approval_status"
  ],
  "properties": {
    "content_summary": {
      "type": "string",
      "minLength": 20
    },
    "content_limitations": {
      "type": "string",
      "minLength": 20
    },
    "evidence_grade": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "U",
        ""
      ]
    },
    "medical_review_required": {
      "type": "boolean"
    },
    "testing_required": {
      "type": "boolean"
    },
    "commercial_relationship": {
      "enum": [
        "none",
        "affiliate",
        "product_supplied",
        "sponsored"
      ]
    },
    "next_content_review_date": {
      "type": "string",
      "format": "date"
    },
    "editorial_approval_status": {
      "enum": [
        "idea",
        "assigned",
        "researching",
        "drafting",
        "editorial_review",
        "fact_check",
        "medical_review",
        "testing_incomplete",
        "commercial_review",
        "ready",
        "published",
        "update_due",
        "correction_pending",
        "archived"
      ]
    },
    "review_score_dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "weight",
          "score"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 5
          }
        },
        "additionalProperties": false
      }
    },
    "product_brand": { "type": "string", "maxLength": 120 },
    "product_variant": { "type": "string", "maxLength": 120 },
    "product_price_amount": { "type": "number", "minimum": 0, "maximum": 1000000 },
    "product_price_currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "public_test_results": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": ["label", "observed_value", "status", "display_order"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 100 },
          "observed_value": { "type": "string", "minLength": 1, "maxLength": 120 },
          "unit": { "type": "string", "maxLength": 40 },
          "reference_label": { "type": "string", "maxLength": 100 },
          "reference_value": { "type": "string", "maxLength": 120 },
          "status": { "enum": ["meets", "partially_meets", "does_not_meet", "informational", "not_applicable"] },
          "note": { "type": "string", "maxLength": 500 },
          "display_order": { "type": "integer", "minimum": 0, "maximum": 999 }
        }
      }
    }
  },
  "additionalProperties": true
}
