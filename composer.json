{
    "name": "longevity-evidence-lab/platform",
    "description": "First-party quality tooling for the Longevity Evidence Lab WordPress platform.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-filter": "*",
        "ext-hash": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pcre": "*"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/php-compatibility": "^9.3",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "vimeo/psalm": "6.16.1",
        "wp-coding-standards/wpcs": "3.4.1"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.3.16"
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": [
            "@phpcs",
            "@phpstan"
        ],
        "test": [
            "@test:discovery",
            "@phpunit",
            "@test:routes"
        ],
        "phpcs": "@php -d error_reporting=8191 vendor/squizlabs/php_codesniffer/bin/phpcs -q --runtime-set ignore_warnings_on_exit 1",
        "phpcbf": "@php -d error_reporting=8191 vendor/squizlabs/php_codesniffer/bin/phpcbf",
        "phpstan": "@php vendor/phpstan/phpstan/phpstan analyse --no-progress",
        "phpunit": "@php vendor/phpunit/phpunit/phpunit --colors=always",
        "test:discovery": "php scripts/verify-test-discovery.php",
        "test:routes": "php tests/php/RoutesTest.php",
        "test:fallback": "php tests/php/run-unit-tests.php"
    }
}
